   "source": [
    "def pkcs7_pad(data, block_size):\n",
    "    padding_length = block_size - (len(data) % block_size)\n",
    "    return data + bytes([padding_length]) * padding_length"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "28165da9-9613-4922-91ec-60d0fd8883d4",
