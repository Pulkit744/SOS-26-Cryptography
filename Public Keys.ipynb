    "def solve():\n",
    "    message = 12\n",
    "    e = 65537\n",
    "    p = 17\n",
    "    q = 23\n",
    "    \n",
    "    N = p * q\n",
    "    ciphertext = pow(message, e, N)\n",
    "    print(ciphertext)\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    solve()"
